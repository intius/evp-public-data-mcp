      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/intius/evp-public-data-mcp/releases/download/v0.1.1/evp-public-data-mcp.mcpb",
